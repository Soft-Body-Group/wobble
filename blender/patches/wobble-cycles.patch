+  WobbleTarget target;
+  target.handle = int64_t(handle);
+  target.size = size_t(size);
+  target.uuid.assign(reinterpret_cast<const uint8_t *>(uuid),
+                     reinterpret_cast<const uint8_t *>(uuid) + uuid_len);
+  target.stamp_name = stamp;
+  wobble_target_set(target);
+  Py_RETURN_NONE;
+}
