+ * shared buffer; `wobble_target(0, 0, b"", "")` clears it. */
+static PyObject *wobble_target_func(PyObject * /*self*/, PyObject *args)
+{
+  long long handle = 0;
+  Py_ssize_t size = 0;
+  const char *uuid = nullptr;
+  Py_ssize_t uuid_len = 0;
+  const char *stamp = nullptr;
