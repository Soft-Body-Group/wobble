+/* SPDX-FileCopyrightText: 2026 Blender Authors
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later */
+
+/* wobble fork: the prebuilt libraries were compiled against the MSVC 17.14
+ * STL, whose vectorized algorithms call helpers the 17.11 runtime this box
+ * links against does not have. These are plain scalar versions with the
+ * STL's own signatures (vector_algorithms.cpp), linked only into this build. */
+
+#if defined(_MSC_VER) && _MSC_VER < 1944
+
+#  include <cstddef>
+#  include <cstdint>
+#  include <cstring>
+
+extern "C" {
+
+size_t __stdcall __std_find_first_of_trivial_pos_1(const void *haystack,
+                                                   size_t haystack_length,
+                                                   const void *needle,
+                                                   size_t needle_length) noexcept
+{
+  const unsigned char *h = static_cast<const unsigned char *>(haystack);
+  const unsigned char *n = static_cast<const unsigned char *>(needle);
+  for (size_t i = 0; i < haystack_length; i++) {
+    if (std::memchr(n, h[i], needle_length)) {
+      return i;
+    }
+  }
+  return size_t(-1);
+}
+
+size_t __stdcall __std_find_last_of_trivial_pos_1(const void *haystack,
+                                                  size_t haystack_length,
+                                                  const void *needle,
+                                                  size_t needle_length) noexcept
+{
+  const unsigned char *h = static_cast<const unsigned char *>(haystack);
+  const unsigned char *n = static_cast<const unsigned char *>(needle);
+  for (size_t i = haystack_length; i-- > 0;) {
+    if (std::memchr(n, h[i], needle_length)) {
+      return i;
+    }
+  }
+  return size_t(-1);
+}
+
+void *__stdcall __std_remove_4(void *first, void *last, uint32_t value) noexcept
+{
+  uint32_t *in = static_cast<uint32_t *>(first);
+  uint32_t *end = static_cast<uint32_t *>(last);
+  uint32_t *out = in;
+  for (; in != end; in++) {
+    if (*in != value) {
+      *out++ = *in;
+    }
+  }
+  return out;
+}
+
+const void *__stdcall __std_search_1(const void *first1,
+                                     const void *last1,
+                                     const void *first2,
+                                     size_t count2) noexcept
+{
+  const unsigned char *a = static_cast<const unsigned char *>(first1);
+  const unsigned char *a_end = static_cast<const unsigned char *>(last1);
+  const unsigned char *b = static_cast<const unsigned char *>(first2);
+  if (count2 == 0) {
+    return first1;
+  }
+  if (size_t(a_end - a) < count2) {
+    return last1;
+  }
+  for (const unsigned char *p = a; p + count2 <= a_end; p++) {
+    if (std::memcmp(p, b, count2) == 0) {
+      return p;
+    }
+  }
+  return last1;
+}
+}
+
+#endif
