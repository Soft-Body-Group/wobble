diff --git a/intern/cycles/blender/wobble.cpp b/intern/cycles/blender/wobble.cpp
new file mode 100644
index 00000000000..edf41c5011f
--- /dev/null
+++ b/intern/cycles/blender/wobble.cpp
@@ -0,0 +1,228 @@
+/* SPDX-FileCopyrightText: 2026 Blender Authors
+ *
+ * SPDX-License-Identifier: Apache-2.0 */
+
+#include "blender/wobble.h"
+
+#include "util/log.h"
+
+#ifdef _WIN32
+#  ifndef NOMINMAX
+#    define NOMINMAX
+#  endif
+#  include <windows.h>
+#endif
+
+#ifdef __APPLE__
+#  include <fcntl.h>
+#  include <sys/mman.h>
+#  include <sys/stat.h>
+#  include <unistd.h>
+#endif
+
+#include <atomic>
+
+CCL_NAMESPACE_BEGIN
+
+static thread_mutex wobble_mutex;
+static WobbleTarget wobble_target;
+/* Bumped on every set/clear: a driver holding an older id re-reads the target. */
+static std::atomic<uint64_t> wobble_generation = 0;
+
+void wobble_target_set(const WobbleTarget &target)
+{
+  thread_scoped_lock lock(wobble_mutex);
+  wobble_target = target;
+  wobble_generation++;
+}
+
+void wobble_target_clear()
+{
+  thread_scoped_lock lock(wobble_mutex);
+  wobble_target = WobbleTarget();
+  wobble_generation++;
+}
+
+bool wobble_target_active()
+{
+  thread_scoped_lock lock(wobble_mutex);
+  return wobble_target.handle != 0;
+}
+
+WobbleTeeDisplayDriver::~WobbleTeeDisplayDriver()
+{
+  close_stamp();
+#ifdef __APPLE__
+  for (const Mapping &m : retired_) {
+    if (m.buffer) {
+      wobble_metal_release(m.buffer);
+    }
+    munmap(m.base, m.len);
+  }
+  retired_.clear();
+#endif
+}
+
+void WobbleTeeDisplayDriver::close_stamp()
+{
+#ifdef _WIN32
+  if (stamp_) {
+    UnmapViewOfFile(stamp_);
+    stamp_ = nullptr;
+  }
+  if (stamp_mapping_) {
+    CloseHandle(HANDLE(stamp_mapping_));
+    stamp_mapping_ = nullptr;
+  }
+#elif defined(__APPLE__)
+  if (mapping_.base) {
+    retired_.push_back(mapping_);
+    mapping_ = Mapping();
+  }
+  stamp_ = nullptr;
+#endif
+}
+
+void WobbleTeeDisplayDriver::refresh_target()
+{
+  const uint64_t gen = wobble_generation.load();
+  if (gen == buffer_id_) {
+    return;
+  }
+  {
+    thread_scoped_lock lock(wobble_mutex);
+    target_ = wobble_target;
+  }
+  buffer_id_ = gen;
+  /* A new buffer: the mirror is re-imported on its next use. */
+  mirror_.clear();
+  close_stamp();
+#ifdef _WIN32
+  if (target_.handle != 0 && !target_.stamp_name.empty()) {
+    HANDLE m = OpenFileMappingA(FILE_MAP_ALL_ACCESS, FALSE, target_.stamp_name.c_str());
+    if (m) {
+      stamp_mapping_ = m;
+      stamp_ = static_cast<WobbleStamp *>(
+          MapViewOfFile(m, FILE_MAP_ALL_ACCESS, 0, 0, sizeof(WobbleStamp)));
+    }
+    else {
+      LOG_ERROR << "wobble: no stamp block named " << target_.stamp_name;
+    }
+  }
+#elif defined(__APPLE__)
+  if (target_.handle != 0 && !target_.stamp_name.empty()) {
+    const int fd = shm_open(target_.stamp_name.c_str(), O_RDWR);
+    struct stat st;
+    if (fd < 0 || fstat(fd, &st) != 0 || size_t(st.st_size) <= WOBBLE_HEADER_BYTES) {
+      LOG_ERROR << "wobble: no shared buffer named " << target_.stamp_name;
+    }
+    else {
+      void *base = mmap(nullptr, size_t(st.st_size), PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0);
+      if (base == MAP_FAILED) {
+        LOG_ERROR << "wobble: could not map " << target_.stamp_name;
+      }
+      else {
+        mapping_.base = base;
+        mapping_.len = size_t(st.st_size);
+        stamp_ = static_cast<WobbleStamp *>(base);
+        /* What the pixels can hold is what wobble mapped, whatever it said. */
+        target_.size = mapping_.len - WOBBLE_HEADER_BYTES;
+      }
+    }
+    if (fd >= 0) {
+      close(fd);
+    }
+  }
+#endif
+}
+
+bool WobbleTeeDisplayDriver::update_begin(const Params &params, const int width, const int height)
+{
+  mirroring_ = false;
+  /* Blender's display first: when it skips an update, Cycles skips the copy
+   * altogether, so there is nothing to mirror either. */
+  if (!BlenderDisplayDriver::update_begin(params, width, height)) {
+    return false;
+  }
+  refresh_target();
+  if (target_.handle == 0 || !stamp_) {
+    return true;
+  }
+  if (size_t(wobble_padded_width(width)) * size_t(height) * sizeof(half4) > target_.size) {
+    /* wobble sized the buffer; a bigger render waits for a bigger buffer. */
+    return true;
+  }
+  params_ = params;
+  width_ = width;
+  height_ = height;
+  mirroring_ = true;
+  stamp_->seq |= 1; /* odd: being written */
+  return true;
+}
+
+void WobbleTeeDisplayDriver::update_end()
+{
+  BlenderDisplayDriver::update_end();
+  if (!mirroring_ || !stamp_) {
+    return;
+  }
+  mirroring_ = false;
+  stamp_->magic = 0x43594357; /* 'WCYC' */
+#ifdef __APPLE__
+  stamp_->version = 2;
+#else
+  stamp_->version = 1;
+#endif
+  stamp_->width = uint32_t(width_);
+  stamp_->height = uint32_t(height_);
+  stamp_->full_width = uint32_t(params_.full_size.x);
+  stamp_->full_height = uint32_t(params_.full_size.y);
+  stamp_->updates++;
+  stamp_->buffer_id = buffer_id_;
+  std::atomic_thread_fence(std::memory_order_seq_cst);
+  stamp_->seq += 1; /* even again: complete */
+}
+
+GraphicsInteropBuffer *WobbleTeeDisplayDriver::mirror_interop_buffer()
+{
+  if (!mirroring_) {
+    return nullptr;
+  }
+#ifdef _WIN32
+  if (mirror_.is_empty()) {
+    /* The interop closes what it is given: hand it a copy of ours. */
+    HANDLE dup = nullptr;
+    if (!DuplicateHandle(GetCurrentProcess(),
+                         HANDLE(target_.handle),
+                         GetCurrentProcess(),
+                         &dup,
+                         0,
+                         FALSE,
+                         DUPLICATE_SAME_ACCESS))
+    {
+      LOG_ERROR << "wobble: DuplicateHandle failed (" << GetLastError() << ")";
+      return nullptr;
+    }
+    mirror_.assign(GraphicsInteropDevice::VULKAN, int64_t(dup), target_.size);
+  }
+  return &mirror_;
+#elif defined(__APPLE__)
+  if (mirror_.is_empty()) {
+    if (!mapping_.buffer) {
+      mapping_.buffer = wobble_metal_wrap(static_cast<uint8_t *>(mapping_.base) +
+                                              WOBBLE_HEADER_BYTES,
+                                          mapping_.len - WOBBLE_HEADER_BYTES);
+      if (!mapping_.buffer) {
+        LOG_ERROR << "wobble: Metal refused the shared pages";
+        return nullptr;
+      }
+    }
+    mirror_.assign(GraphicsInteropDevice::METAL, int64_t(mapping_.buffer), target_.size);
+  }
+  return &mirror_;
+#else
+  return nullptr;
+#endif
+}
+
+CCL_NAMESPACE_END
diff --git a/intern/cycles/blender/wobble.h b/intern/cycles/blender/wobble.h
new file mode 100644
index 00000000000..08e59fc8ff9
--- /dev/null
+++ b/intern/cycles/blender/wobble.h
@@ -0,0 +1,131 @@
+/* SPDX-FileCopyrightText: 2026 Blender Authors
+ *
+ * SPDX-License-Identifier: Apache-2.0 */
+
+/* wobble fork: Cycles renders straight into a buffer wobble owns.
+ *
+ * wobble (a separate process) allocates an exportable Vulkan buffer of
+ * half4 pixels on the same GPU, duplicates its Win32 handle into this
+ * process and names it with `_cycles.wobble_target(...)`. While a target is
+ * set, every non-preview Cycles session (F12 and the rendered viewport)
+ * mirrors its display updates into it as well as into Blender's own
+ * display: Cycles' existing Vulkan graphics interop imports the buffer into
+ * CUDA and writes each update into it, and the driver bumps a sequence in a
+ * small shared stamp block wobble polls. No readback, no CPU copy.
+ *
+ * macOS: Cycles' Metal interop already takes a plain MTLBuffer on unified
+ * memory, so there is nothing to import. wobble creates ONE POSIX shared
+ * memory object named by `stamp_name`: the stamp in its first
+ * `WOBBLE_HEADER_BYTES` (a whole arm64 page, so what follows is page
+ * aligned), the pixels after it. The fork wraps the pixel pages in an
+ * MTLBuffer (`newBufferWithBytesNoCopy`) and Cycles writes into them. `handle`
+ * is only a flag there (non-zero = bound). Rows are padded to 256 bytes
+ * (`wobble_padded_width`) so wobble copies the buffer straight into a
+ * texture; the stamp says so with version 2. */
+
+#pragma once
+
+/* display_driver.h leans on its includer for these. */
+#include "DNA_view3d_types.h"
+#include "RE_engine.h"
+
+#include "blender/display_driver.h"
+#include "session/display_driver.h"
+
+#include "util/thread.h"
+#include "util/vector.h"
+
+#include <string>
+
+CCL_NAMESPACE_BEGIN
+
+/* What wobble handed over; empty `handle` = no target. */
+struct WobbleTarget {
+  int64_t handle = 0;
+  size_t size = 0;
+  vector<uint8_t> uuid;
+  std::string stamp_name;
+};
+
+void wobble_target_set(const WobbleTarget &target);
+void wobble_target_clear();
+bool wobble_target_active();
+
+/* macOS: the stamp occupies this much of the shared object; pixels follow. */
+#define WOBBLE_HEADER_BYTES 16384
+
+/* Row length in pixels of the mirror: Windows packs rows (version 1), macOS
+ * pads them to 256 bytes = 32 half4 pixels (version 2). */
+inline int wobble_padded_width(const int width)
+{
+#ifdef __APPLE__
+  return (width + 31) / 32 * 32;
+#else
+  return width;
+#endif
+}
+
+/* Layout of the stamp block, mirrored by wobble (`engine/src/blender/cycles.rs`). */
+struct WobbleStamp {
+  uint32_t magic;   /* 'WCYC' */
+  uint32_t version; /* 1: rows packed at width; 2: rows at wobble_padded_width */
+  uint64_t seq;     /* bumped after every completed update; odd while writing */
+  uint32_t width;   /* pixels written this update (row stride = width) */
+  uint32_t height;
+  uint32_t full_width; /* the render's full resolution */
+  uint32_t full_height;
+  uint64_t updates;   /* total display updates since the target was set */
+  uint64_t buffer_id; /* which target buffer the pixels went to */
+};
+
+/* Blender's own viewport/render display, plus a mirror: while wobble has a
+ * buffer bound, every display update is ALSO written into it by Cycles'
+ * Vulkan interop (`PathTraceWorkGPU::copy_to_display_mirror`) and the stamp
+ * is bumped. So Blender's viewport and wobble both show the render. */
+class WobbleTeeDisplayDriver : public BlenderDisplayDriver {
+ public:
+  using BlenderDisplayDriver::BlenderDisplayDriver;
+  ~WobbleTeeDisplayDriver() override;
+
+  GraphicsInteropBuffer *mirror_interop_buffer() override;
+
+ protected:
+  bool update_begin(const Params &params, const int width, const int height) override;
+  void update_end() override;
+
+  /* Re-read the target after a set/clear; open its stamp block. */
+  void refresh_target();
+  void close_stamp();
+
+  WobbleTarget target_;
+  uint64_t buffer_id_ = 0;
+  int width_ = 0, height_ = 0;
+  Params params_;
+  /* This update goes to wobble too. */
+  bool mirroring_ = false;
+  GraphicsInteropBuffer mirror_;
+  void *stamp_mapping_ = nullptr;
+  WobbleStamp *stamp_ = nullptr;
+#ifdef __APPLE__
+  /* The whole shared object (stamp + pixels) and the MTLBuffer over its
+   * pixels. Cycles' interop keeps an unretained pointer to the buffer until
+   * it is handed a new one, so a retired mapping is only freed with the
+   * driver. */
+  struct Mapping {
+    void *base = nullptr;
+    size_t len = 0;
+    void *buffer = nullptr; /* id<MTLBuffer>, retained */
+  };
+  Mapping mapping_;
+  vector<Mapping> retired_;
+#endif
+};
+
+#ifdef __APPLE__
+/* wobble_metal.mm: an MTLBuffer (retained) over `len` bytes at `ptr`, both
+ * page aligned, on the system GPU; null on failure. */
+void *wobble_metal_wrap(void *ptr, size_t len);
+void wobble_metal_release(void *buffer);
+#endif
+
+CCL_NAMESPACE_END
diff --git a/intern/cycles/blender/wobble_metal.mm b/intern/cycles/blender/wobble_metal.mm
new file mode 100644
index 00000000000..c360b2a027d
--- /dev/null
+++ b/intern/cycles/blender/wobble_metal.mm
@@ -0,0 +1,35 @@
+/* SPDX-FileCopyrightText: 2026 Blender Authors
+ *
+ * SPDX-License-Identifier: Apache-2.0 */
+
+/* wobble fork, macOS: wobble's shared pages as an MTLBuffer for Cycles. */
+
+#include "blender/wobble.h"
+
+#import <Metal/Metal.h>
+
+CCL_NAMESPACE_BEGIN
+
+void *wobble_metal_wrap(void *ptr, const size_t len)
+{
+  /* One GPU on Apple silicon, and the system default is the device object
+   * Cycles' Metal device uses. */
+  id<MTLDevice> device = MTLCreateSystemDefaultDevice();
+  if (!device) {
+    return nullptr;
+  }
+  id<MTLBuffer> buffer = [device newBufferWithBytesNoCopy:ptr
+                                                   length:len
+                                                  options:MTLResourceStorageModeShared
+                                              deallocator:nil];
+  [device release];
+  /* `new...` returns it retained; the caller owns it. */
+  return (void *)buffer;
+}
+
+void wobble_metal_release(void *buffer)
+{
+  [(id<MTLBuffer>)buffer release];
+}
+
+CCL_NAMESPACE_END
