diff --git a/intern/cycles/integrator/path_trace_work_gpu.cpp b/intern/cycles/integrator/path_trace_work_gpu.cpp
index c1f62481090..2e793f0c5cf 100644
--- a/intern/cycles/integrator/path_trace_work_gpu.cpp
+++ b/intern/cycles/integrator/path_trace_work_gpu.cpp
@@ -1012,6 +1012,7 @@ void PathTraceWorkGPU::copy_to_display(PathTraceDisplay *display,
 
   if (should_use_graphics_interop(display)) {
     if (copy_to_display_interop(display, pass_mode, num_samples)) {
+      copy_to_display_mirror(display, pass_mode, num_samples);
       return;
     }
 
@@ -1021,6 +1022,60 @@ void PathTraceWorkGPU::copy_to_display(PathTraceDisplay *display,
   }
 
   copy_to_display_naive(display, pass_mode, num_samples);
+  copy_to_display_mirror(display, pass_mode, num_samples);
+}
+
+void PathTraceWorkGPU::copy_to_display_mirror(PathTraceDisplay *display,
+                                              PassMode pass_mode,
+                                              const int num_samples)
+{
+  /* wobble fork: the same film pixels a second time, into the buffer another
+   * process shares. One more film-convert kernel; no copy through the host. */
+  GraphicsInteropBuffer *mirror = display->graphics_interop_get_mirror_buffer();
+  if (!mirror) {
+    return;
+  }
+  if (mirror->has_new_handle()) {
+    mirror_failed_ = false;
+  }
+  if (mirror_failed_) {
+    return;
+  }
+  if (!mirror_graphics_interop_) {
+    mirror_graphics_interop_ = queue_->graphics_interop_create();
+    if (!mirror_graphics_interop_) {
+      mirror_failed_ = true;
+      return;
+    }
+  }
+  mirror_graphics_interop_->set_buffer(*mirror);
+  const device_ptr d_rgba_half = mirror_graphics_interop_->map();
+  if (!d_rgba_half) {
+    LOG_ERROR << "wobble: could not map the mirror buffer";
+    mirror_failed_ = true;
+    return;
+  }
+
+  PassAccessor::Destination destination = get_display_destination_template(display, pass_mode);
+#ifdef __APPLE__
+  /* macOS rows are padded to 256 bytes (32 half4), so wobble copies the
+   * buffer straight into a texture: `wobble_padded_width` in
+   * blender/wobble.h, which this must match. */
+  if (destination.stride > 0) {
+    const int padded = (destination.stride + 31) / 32 * 32;
+    const int x = destination.offset % destination.stride;
+    const int y = destination.offset / destination.stride;
+    destination.offset = y * padded + x;
+    destination.stride = padded;
+  }
+#endif
+  destination.d_pixels_half_rgba = d_rgba_half;
+  get_render_tile_film_pixels(destination, pass_mode, num_samples);
+
+  mirror_graphics_interop_->unmap();
+  /* The other process reads the buffer as soon as the update ends: the
